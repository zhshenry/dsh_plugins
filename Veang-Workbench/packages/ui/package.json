{
  "name": "veang-workbench-ui",
  "version": "0.2.3",
  "description": "Project explorer, file workbench, context dock, and conversation history for DeepSeek Harness",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhshenry/veang-workbench.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "dsh": {
    "client": {
      "inject": [
        "slots",
        "sessions",
        "workspaces"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "mammoth": "^1.10.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  }
}
