{
  "name": "veang-workbench",
  "version": "0.2.3",
  "description": "A desktop-style project and AI workbench for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "workbench"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhshenry/veang-workbench.git",
    "directory": "packages/bundle"
  },
  "homepage": "https://github.com/zhshenry/veang-workbench#readme",
  "bugs": {
    "url": "https://github.com/zhshenry/veang-workbench/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "prepack": "node ../../scripts/build-bundle.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./embedded/ui/client.js",
    "./ui": "./embedded/ui/index.js",
    "./ui/package.json": "./embedded/ui/package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "embedded",
    "assets",
    "vendor",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "sessions",
        "workspaces"
      ]
    }
  },
  "dependencies": {
    "mammoth": "^1.10.0"
  },
  "engines": {
    "node": ">=22"
  }
}
